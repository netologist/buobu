# ============================================================================
# buobu environment variables
# ============================================================================
# Copy to `.env.local` for local development:   cp .env.example .env.local
#
# MODE: Local Mode is opted into; everything else is Cloud Mode.
#
#   NEXT_PUBLIC_LOCAL_MODE=true  ->  Local Mode. No account, no sync, no server;
#   data lives only in the browser. Set below, so a copy of this file is a
#   working local setup.
#
#   Anything else, including unset  ->  Cloud Mode. Accounts, sync, billing, MCP.
#   NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are then
#   both required; without them the build stops with an error rather than
#   quietly serving a local-only app to real users.
#
# Never set NEXT_PUBLIC_LOCAL_MODE on a deployed build.
#
# Mode is baked in at build time, so after changing it, rebuild or restart the
# dev server. Setting variables on an already-built artifact does nothing.
#
# Every value below is a placeholder. Nothing here is a real credential, and no
# secret should ever be committed — values marked "server" or "Worker" belong in
# `.env.local`, which is gitignored.
# ============================================================================


# ============================================================================
# MODE
# ============================================================================

# Local Mode: no backend at all. Only the literal string "true" switches it on.
NEXT_PUBLIC_LOCAL_MODE=true


# ============================================================================
# SUPABASE  (Cloud Mode)
# ============================================================================
# Supabase Dashboard > Project Settings > API
# https://supabase.com > your-project > Settings > API
#
# To run Cloud Mode: comment out NEXT_PUBLIC_LOCAL_MODE above, uncomment both of
# the values below, and restart.

# Project URL. Public. A Cloud Mode build fails without it.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key. Public, and scoped by Row Level Security.
# The code reads this name and its alias NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. FULL database access — server and Worker use only.
# Never give this a NEXT_PUBLIC_ prefix: that would inline it into the browser
# bundle. Read by the dev-only routes under src/app/api/ and by the Workers.
# SUPABASE_SERVICE_ROLE_KEY=


# ============================================================================
# FEATURE FLAGS  (all optional; defaults stated)
# ============================================================================

# Home dashboard: the /home page and its nav link.
# Default: DISABLED — the app lands on Tasks instead.
# NEXT_PUBLIC_HOME_PAGE_ENABLED=true

# Invite and referral codes. Needs the Supabase RPCs and the referral Worker.
# Default: enabled in Cloud Mode. Always off in Local Mode.
# NEXT_PUBLIC_INVITE_CODES_ENABLED=false

# Browser storage usage indicator in the header.
# Default: enabled. Only the literal string "false" disables it.
# NEXT_PUBLIC_STORAGE_INDICATOR_ENABLED=false


# ============================================================================
# BILLING (Stripe)  — optional, Cloud Mode only
# ============================================================================
# See docs/setup/billing.md. With billing off, every user is treated as Plus,
# Stripe routes return 503, and none of the values below are needed.
#
# Note: src/app/api/stripe/** is a dev-only surface. The deployed artifact is a
# static export, so those routes do not exist in production.

# Only the literal string "true" enables billing.
# NEXT_PUBLIC_BILLING_ENABLED=true

# Where Stripe Checkout and the Customer Portal send the user back to.
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recurring price IDs for the Plus plan. The checkout route accepts only these
# two, so leaving either unset makes the allow-list incomplete.
# NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY=

# Server-only. src/lib/stripe.ts throws at import when billing is on and this
# is missing.
# STRIPE_SECRET_KEY=

# Server-only. From `stripe listen` locally, from the dashboard endpoint in
# production. Starts with whsec_.
# STRIPE_WEBHOOK_SECRET=


# ============================================================================
# CAPTCHA (Cloudflare Turnstile)  — optional
# ============================================================================

# Public site key. Unset means no captcha is rendered at all — registration,
# login and password reset simply omit it.
# Create at: Cloudflare Dashboard > Turnstile > Add site
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ============================================================================
# MCP WORKER  (Cloud Mode)
# ============================================================================
# See docs/setup/workers.md.

# Public MCP endpoint the app shows in its API-key settings.
# Local dev: pnpm dev:mcp (http://localhost:8787)
# Production: your Worker URL, e.g. https://buobu-mcp.<account>.workers.dev
NEXT_PUBLIC_MCP_URL=http://localhost:8787

# Worker secret: CORS allowed origin for MCP requests.
# Unset means "*" — set it.
# MCP_ALLOWED_ORIGIN=http://localhost:3000


# ============================================================================
# REFERRAL WORKER  (Cloud Mode)
# ============================================================================
# See docs/setup/workers.md.

# Public referral endpoint the app calls.
# Local dev: pnpm dev:referral (http://localhost:8789)
# Production: your Worker URL, e.g. https://buobu-referral.<account>.workers.dev
NEXT_PUBLIC_REFERRAL_API_URL=http://localhost:8789

# Maps to the Worker secret named ALLOWED_ORIGIN (the names differ on purpose).
# Unset means "*" — set it.
# REFERRAL_ALLOWED_ORIGIN=https://your-app-domain.example


# ============================================================================
# BUILD METADATA  — optional
# ============================================================================
# Embedded into the build and shown in the app; useful for telling deployed
# revisions apart.

# NEXT_PUBLIC_BUILD_VERSION=local
# NEXT_PUBLIC_BUILD_TIME=1970-01-01T00:00:00Z


# ============================================================================
# END-TO-END TESTS  — optional
# ============================================================================
# See docs/setup/testing.md. The Playwright suite signs in with a real account
# against a real Supabase project and skips itself when these are unset.

# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# E2E_TEST_INVITE_CODE=


# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================
#
# Local Mode, the default:
#   cp .env.example .env.local && pnpm install && pnpm dev
#   -> http://localhost:3000, no account, no sync, no server.
#
# Cloud Mode:
#   1. cp .env.example .env.local
#   2. Comment out NEXT_PUBLIC_LOCAL_MODE
#   3. Uncomment and fill NEXT_PUBLIC_SUPABASE_URL and
#      NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   4. pnpm dev                    (restart — mode is read at build time)
#   5. Apply supabase/migrations   (see docs/setup/supabase.md)
#
# The Cloudflare Workers are Cloud Mode only and need a Supabase project:
#   pnpm dev:mcp                   (MCP Worker, http://localhost:8787)
#   pnpm dev:referral              (Referral Worker, http://localhost:8789)
#
# For Wrangler authentication: pnpm exec wrangler login


# ============================================================================
# SECURITY NOTES
# ============================================================================

# 1. NEXT_PUBLIC_* values are INLINED INTO THE CLIENT BUNDLE. Only public,
#    non-sensitive configuration belongs there. A secret with that prefix is
#    visible to every visitor.
#
# 2. The Supabase publishable key is public and protected by Row Level Security.
#    The service-role key bypasses RLS entirely — server and Worker use only.
#
# 3. `.gitignore` excludes `.env*` apart from this file, plus
#    workers/*/secrets.json and workers/*/.dev.vars. Keep it that way.
#
# 4. The deployed artifact is a static export (`output: "export"`). Values
#    marked "server" above are read only by routes that run under `pnpm dev`;
#    in production the equivalent work belongs in a Worker or in Supabase.


# ============================================================================
# VARIABLE INDEX
# ============================================================================
# Inlined = baked into the static bundle at build time; changing it on an
# existing artifact has no effect.
#
#   Mode                     NEXT_PUBLIC_LOCAL_MODE                       [inlined]
#   Supabase                 NEXT_PUBLIC_SUPABASE_URL                    [inlined]
#                            NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY         [inlined]
#                            SUPABASE_SERVICE_ROLE_KEY                    [server]
#   Feature flags            NEXT_PUBLIC_HOME_PAGE_ENABLED               [inlined]
#                            NEXT_PUBLIC_INVITE_CODES_ENABLED            [inlined]
#                            NEXT_PUBLIC_STORAGE_INDICATOR_ENABLED       [inlined]
#   Billing                  NEXT_PUBLIC_BILLING_ENABLED                 [inlined]
#                            NEXT_PUBLIC_APP_URL                         [inlined]
#                            NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY       [inlined]
#                            NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY        [inlined]
#                            STRIPE_SECRET_KEY                            [server]
#                            STRIPE_WEBHOOK_SECRET                        [server]
#   Captcha                  NEXT_PUBLIC_TURNSTILE_SITE_KEY              [inlined]
#   MCP Worker               NEXT_PUBLIC_MCP_URL                         [inlined]
#                            MCP_ALLOWED_ORIGIN                           [Worker]
#   Referral Worker          NEXT_PUBLIC_REFERRAL_API_URL                [inlined]
#                            REFERRAL_ALLOWED_ORIGIN                      [Worker]
#   Build metadata           NEXT_PUBLIC_BUILD_VERSION                   [inlined]
#                            NEXT_PUBLIC_BUILD_TIME                      [inlined]
#   E2E tests                E2E_TEST_EMAIL, E2E_TEST_PASSWORD,
#                            E2E_TEST_INVITE_CODE                         [test run]
