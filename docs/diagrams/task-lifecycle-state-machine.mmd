%% Source: src/lib/types.ts (Task), src/hooks/useTaskBoardDragAndDrop.ts and
%% src/components/kanban/KanbanBoard.tsx. This models the kanban lifecycle only.
%% timeboxMinutes is a planned duration used by the calendar and task metadata;
%% it never changes a task's state.
%% routineId marks a task generated by a routine (RoutineLog.taskId). Such a task
%% enters the lifecycle as Active and follows the same transitions.
stateDiagram-v2
    [*] --> Active: created in a column, or promoted from a backlog item
    Active --> Active: move between columns
    Active --> Completed: move into the board done column (archiveColumnId), completedAt set
    Completed --> Active: move out of the done column, completedAt cleared
    Completed --> Archived: archive a done-column task, archived set
    Archived --> Completed: restore, archived cleared
    Active --> Deleted: soft delete (_deleted)
    Completed --> Deleted: soft delete (_deleted)
    Archived --> Deleted: soft delete (_deleted)
    Deleted --> [*]
